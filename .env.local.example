# .env.local.example — copy to .env.local and fill in real values
# .env.local is gitignored; never commit real keys or AM URLs

# Act 4: VIP Personalization crew (external agent demo)

# AM gateway URL for your project/component.
# Pattern: https://<project>-<component>.openchoreoapis.localhost:19080/<agent-endpoint>/
# Find it in AM > your project > component > settings > endpoint
OPENAI_BASE_URL=https://YOUR_PROJECT-YOUR_COMPONENT.openchoreoapis.localhost:19080/vip-personalization/

# Long-lived JWT token from AM. Used both as the API-Key header for LLM
# governance and as AMP_AGENT_API_KEY for OTEL tracing.
# Find it in AM > settings > API keys
OPENAI_API_KEY=YOUR_AM_JWT_HERE

# AMP OTEL collector endpoint (local OpenChoreo dev mode)
# Confirm this port is reachable before demo day:
#   curl -I http://localhost:22893/otel  (should return 415, not connection refused)
AMP_OTEL_ENDPOINT=http://localhost:22893/otel

# Same JWT used by amp-instrument to authenticate the OTEL exporter
AMP_AGENT_API_KEY=${OPENAI_API_KEY}
