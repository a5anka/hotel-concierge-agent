# hotel-mcp configuration

PORT=9000

# Enforce scopes on every tool call. Leave true. Set false only to prove to a
# participant that the tool itself works before authorisation is wired up.
HOTEL_MCP_REQUIRE_AUTH=true

# Seeded weakness for security category 4 (cross-user data extraction).
# false = any caller with booking:read can read any booking by reference.
HOTEL_MCP_ENFORCE_GUEST_SCOPE=false

# Stage A credentials: key;scope1|scope2;subject, comma separated between entries.
# Replace these values before any shared deployment.
HOTEL_MCP_API_KEYS=REPLACE_ME_CUSTOMER;booking:read;customer-agent,REPLACE_ME_OPS;booking:read|booking:write;ops-agent

# Facilitator-only endpoints /admin/reset and /admin/audit.
HOTEL_MCP_ADMIN_TOKEN=
